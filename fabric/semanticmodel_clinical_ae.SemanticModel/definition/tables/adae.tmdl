table adae
	lineageTag: c55db511-01d7-45fa-938e-c11b73504af1
	sourceLineageTag: [gold].[adae]

	measure 'N Safety' =
			
			CALCULATE ( DISTINCTCOUNT ( adsl[USUBJID] ), adsl[SAFFL] = "Y" )
		formatString: 0
		lineageTag: 700eafd9-b094-46b9-a972-4a931266ea82

		changedProperty = Name

	measure 'Subjects with TEAE' =
			
			CALCULATE ( DISTINCTCOUNT ( adae[USUBJID] ), adae[TRTEMFL] = "Y", adae[SAFFL] = "Y" )
		formatString: 0
		lineageTag: da198a34-24bb-44ce-919d-2a829f172935

		changedProperty = Name

	measure 'TEAE %' =
			
			DIVIDE ( [Subjects with TEAE], [N Safety] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 42703da6-fe04-4b96-8f1d-dd0ccc9fa282

		changedProperty = Name

		changedProperty = FormatString

	measure 'TEAE Events' =
			
			CALCULATE ( COUNTROWS ( adae ), adae[TRTEMFL] = "Y", adae[SAFFL] = "Y" )
		formatString: 0
		lineageTag: 9bea2b22-6f8b-4277-8b2d-9cf27904b7e8

		changedProperty = Name

